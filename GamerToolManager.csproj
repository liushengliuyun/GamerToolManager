<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>GamerToolManager</AssemblyName>
    <RootNamespace>GamerToolManager</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>


    <Version>1.6.1</Version>

    <AssemblyTitle>GamerTool 管理器</AssemblyTitle>
    <Product>GamerTool 管理器</Product>
  </PropertyGroup>

  <!-- 仓库根存在 gitignored 的 Secrets.cs 时启用内置上传令牌；公开源码构建自动退化为空令牌（上传禁用） -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)Secrets.cs')">
    <DefineConstants>$(DefineConstants);HAS_UPLOAD_TOKEN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- SteamKit2 3.x：纯托管包，单文件发布无需额外参数 -->
    <PackageReference Include="SteamKit2" Version="3.*" />
  </ItemGroup>

</Project>
